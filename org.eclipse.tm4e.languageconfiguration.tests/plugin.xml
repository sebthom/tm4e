<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<!-- Contributes content types and language configurations for editor integration tests. -->
<plugin>
   <extension
         point="org.eclipse.core.contenttype.contentTypes">
      <!-- The dedicated extension isolates the counter; the JavaScript base supplies a grammar and editing rules. -->
      <content-type
            base-type="org.eclipse.tm4e.language_pack.javascript"
            describer="org.eclipse.tm4e.languageconfiguration.tests.CountingContentDescriber"
            file-extensions="lc-counted"
            id="org.eclipse.tm4e.languageconfiguration.tests.content-type.counted"
            name="Test content type with counted detection"
            priority="normal">
      </content-type>
      <content-type
            base-type="org.eclipse.core.runtime.text"
            file-extensions="lc-test"
            id="org.eclipse.tm4e.languageconfiguration.tests.content-type1"
            name="Test Language Configuration content-type"
            priority="normal">
      </content-type>
      <content-type
            base-type="org.eclipse.core.runtime.text"
            file-extensions="noLineComment"
            id="org.eclipse.tm4e.languageconfiguration.tests.content-type.noLineComment"
            name="Test Language Configuration content-type no line comment"
            priority="normal">
      </content-type>
      <content-type
            base-type="org.eclipse.core.runtime.text"
            file-extensions="noBlockComment"
            id="org.eclipse.tm4e.languageconfiguration.tests.content-type.noBlockComment"
            name="Test Language Configuration content-type no block comment"
            priority="normal">
      </content-type>
   </extension>
   <extension
         point="org.eclipse.tm4e.languageconfiguration.languageConfigurations">
      <languageConfiguration
            contentTypeId="org.eclipse.tm4e.languageconfiguration.tests.content-type1"
            path="language-configurations/language-configuration.json">
      </languageConfiguration>
      <languageConfiguration
            contentTypeId="org.eclipse.tm4e.languageconfiguration.tests.content-type.noLineComment"
            path="language-configurations/language-configuration-no-linecomment.json">
      </languageConfiguration>
      <languageConfiguration
            contentTypeId="org.eclipse.tm4e.languageconfiguration.tests.content-type.noBlockComment"
            path="language-configurations/language-configuration-no-blockcomment.json">
      </languageConfiguration>
   </extension>
   <extension
         point="org.eclipse.ui.editors">
      <editorContentTypeBinding
        contentTypeId="org.eclipse.tm4e.languageconfiguration.tests.content-type1"
        editorId="org.eclipse.ui.genericeditor.GenericEditor">
      </editorContentTypeBinding>
   </extension>

</plugin>
